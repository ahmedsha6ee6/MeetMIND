# ─── MeetMind .gitignore (F16 fix) ───────────────────────────────────────────

# Secrets – NEVER commit
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Node / React
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local

# Docker volumes – large binary files, never commit
volumes/uploads/
volumes/outputs/
volumes/models/

# AI model weights – large files
*.bin
*.gguf
*.safetensors
*.pt
*.pth
*.onnx

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Alembic – do NOT ignore versions/ (they are source code)
# but ignore auto-generated __pycache__ inside
alembic/__pycache__/
alembic/versions/__pycache__/
