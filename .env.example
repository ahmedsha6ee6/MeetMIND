# ─── MeetMind Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=meetmind
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=change_me_strong_password

DATABASE_URL=postgresql+asyncpg://meetmind:change_me_strong_password@postgres:5432/meetmind

# ── Redis / ARQ ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Authentication (F1 fix – single-user token) ───────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_TOKEN=change_me_generate_a_random_token_here
API_USERNAME=admin
API_PASSWORD=change_me_strong_password

# ── Ollama / LLM (F4 fix) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b          # Small quantised model for 4 GB VRAM

# ── Faster-Whisper (F10 fix – pre-defined model size) ────────────────────────
WHISPER_MODEL_SIZE=base            # tiny | base | small | medium (avoid large on 4GB VRAM)
WHISPER_DEVICE=cuda                # cuda | cpu  (auto-falls back to cpu if unavailable)
WHISPER_MODEL_DIR=/app/models

# ── Upload limits (F3 fix) ────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/x-m4a,audio/mp4,audio/ogg

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
